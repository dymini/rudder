DATABASE_URL=postgres://dymini-panel:dymini-panel@127.0.0.1:5432/dymini-panel
DYMINI_PANEL_BIND=0.0.0.0:3000
# Generate with: openssl rand -hex 32
DYMINI_PANEL_MASTER_KEY=replace-with-64-random-hex-characters
DYMINI_PANEL_DATA_DIR=/var/lib/dymini-panel
DYMINI_PANEL_LOG_FORMAT=pretty
DYMINI_PANEL_COOKIE_SECURE=false
DYMINI_PANEL_GITHUB_REPO=vantanminh/rudder
# DYMINI_PANEL_PUBLIC_URL=https://panel.example.com
# DYMINI_PANEL_MASTER_KEY_FILE=/var/lib/dymini-panel/master.key
# DYMINI_PANEL_SETUP_TOKEN=choose-a-long-random-token   # default: generated into $DYMINI_PANEL_DATA_DIR/setup-token

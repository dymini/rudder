DATABASE_URL=postgres://rudder:rudder@127.0.0.1:5432/rudder
RUDDER_BIND=0.0.0.0:3000
# Generate with: openssl rand -hex 32
RUDDER_MASTER_KEY=replace-with-64-random-hex-characters
RUDDER_DATA_DIR=/var/lib/rudder
RUDDER_LOG_FORMAT=pretty
RUDDER_COOKIE_SECURE=false
RUDDER_GITHUB_REPO=vantanminh/rudder
# RUDDER_PUBLIC_URL=https://panel.example.com
# RUDDER_MASTER_KEY_FILE=/var/lib/rudder/master.key
# RUDDER_SETUP_TOKEN=choose-a-long-random-token   # default: generated into $RUDDER_DATA_DIR/setup-token

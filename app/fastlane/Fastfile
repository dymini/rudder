# TestFlight pipeline for the Dymini Panel iOS app. Runs on the GitHub macos runner.
# Apple auth is a single App Store Connect API key supplied through env:
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8_BASE64 (base64 of the .p8 file)

default_platform(:ios)

APPLE_TEAM_ID = "M5J76DW97F"
BUNDLE_ID = "com.vantanminh.dyminipanel"

platform :ios do
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: Base64.decode64(ENV.fetch("ASC_KEY_P8_BASE64")),
      is_key_content_base64: false,
      in_house: false
    )

    create_keychain(
      name: "ci",
      password: "ci",
      default_keychain: true,
      unlock: true,
      timeout: 3600
    )

    # The App Store Connect app record cannot be created through the API
    # (Apple forbids CREATE on /v1/apps): create it once in the web UI.
    #
    # Distribution certificate: Apple caps the account at a few distribution
    # certificates, and a fresh one per CI run exhausts the quota (the private
    # key dies with the ephemeral runner). A stable certificate is therefore
    # imported from the IOS_DIST_P12_BASE64 / IOS_DIST_P12_PASSWORD secrets;
    # cert (which would create a new one) is only a fallback for first setup.
    if ENV["IOS_DIST_P12_BASE64"] && !ENV["IOS_DIST_P12_BASE64"].empty?
      # Fresh CI keychains lack the Apple WWDR intermediate the distribution
      # certificate chains to; without it the identity fails verification.
      wwdr_path = File.expand_path("~/AppleWWDRCAG3.cer")
      sh("curl", "-fsSL", "-o", wwdr_path, "https://www.apple.com/certificateauthority/AppleWWDRCAG3.cer")
      import_certificate(
        certificate_path: wwdr_path,
        keychain_path: File.expand_path("~/Library/Keychains/ci-db"),
        keychain_password: "ci"
      )
      p12_path = File.expand_path("~/dist.p12")
      File.binwrite(p12_path, Base64.decode64(ENV.fetch("IOS_DIST_P12_BASE64")))
      import_certificate(
        certificate_path: p12_path,
        certificate_password: ENV.fetch("IOS_DIST_P12_PASSWORD"),
        keychain_path: File.expand_path("~/Library/Keychains/ci-db"),
        keychain_password: "ci"
      )
    else
      cert(
        api_key: api_key,
        keychain_path: File.expand_path("~/Library/Keychains/ci-db"),
        keychain_password: "ci"
      )
    end

    sigh(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      force: false
    )

    profile_path = lane_context[SharedValues::SIGH_PROFILE_PATH]
    profile_uuid = lane_context[SharedValues::SIGH_UUID]

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/Dymini Panel.xcodeproj",
      team_id: APPLE_TEAM_ID,
      bundle_identifier: BUNDLE_ID,
      profile_uuid: profile_uuid,
      code_sign_identity: "Apple Distribution"
    )

    increment_build_number(
      build_number: latest_testflight_build_number(api_key: api_key, app_identifier: BUNDLE_ID) + 1,
      xcodeproj: "ios/Dymini Panel.xcodeproj"
    )

    gym(
      workspace: "ios/Dymini Panel.xcworkspace",
      scheme: "Dymini Panel",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "ios/build",
      output_name: "Dymini Panel.ipa",
      export_options: {
        teamID: APPLE_TEAM_ID,
        signingStyle: "manual",
        provisioningProfiles: {
          BUNDLE_ID => profile_uuid
        }
      },
      xcargs: "CODE_SIGN_IDENTITY='Apple Distribution' DEVELOPMENT_TEAM=#{APPLE_TEAM_ID}"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      notify_external_testers: false
    )

    delete_keychain(name: "ci")
  end
end
